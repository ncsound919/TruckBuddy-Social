# GEMINI_API_KEY: server-side key for the Gemini AI endpoints (src/server/).
# Without it the server returns built-in fallback responses. Never expose it
# to the client.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: the URL where this app is hosted (used for self-referential links).
APP_URL="MY_APP_URL"

# Shared Truck Buddy Supabase project — the same project and identity
# (auth.users.id) used by the cab app and the web portal, so one account works
# on every surface. The anon/publishable key is public by design; RLS is the
# security boundary. Without these the app falls back to seed data.
VITE_SUPABASE_URL="https://ennaghywpvlnprsqqzmq.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_PUBLISHABLE_KEY"

# Auth redirects: the origin you run this app on must be allow-listed in the
# Supabase project (Authentication -> URL Configuration). Localhost:3000 and
# 127.0.0.1:3000 are already allowed.
